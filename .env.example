# Bearer token the mobile app sends in `Authorization: Bearer <token>`.
API_TOKEN=
# Host port where the API is exposed.
API_PORT=51152

# PostgreSQL credentials, used by docker compose to create the database.
POSTGRES_USER=vocora
POSTGRES_PASSWORD=
POSTGRES_DB=vocora
# Host port where PostgreSQL is exposed (inside docker it is always 5432).
POSTGRES_PORT=51153
