# Bearer token the mobile app sends in `Authorization: Bearer <token>`.
API_TOKEN=
# Host port where the API is exposed.
API_PORT=51152

# PostgreSQL credentials, used by docker compose to create the database.
POSTGRES_USER=vocora
POSTGRES_PASSWORD=
POSTGRES_DB=vocora
# Host port where PostgreSQL is exposed (inside docker it is always 5432).
POSTGRES_PORT=51153

# Transcription with faster-whisper. Download the model with `make download_model`.
WHISPER_MODEL=large-v3
WHISPER_MODEL_DIR=data/models
# "cpu" or "cuda" (NVIDIA GPU)
WHISPER_DEVICE=cpu
# "int8" on CPU, "float16" on GPU
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
